# --- Telegram MTProto credentials ---
# my.telegram.org → API development tools
API_ID=
API_HASH=
# Obtained from BotFather
BOT_TOKEN=
# teleproto StringSession; printed by the bot on first login, persist it to
# avoid repeated logins
SESSION=
# Optional persistent session file. SESSION takes precedence on startup; the
# connected session is then written to this file. Deployment examples point
# this at persistent application storage.
SESSION_FILE=

# --- Public serving ---
# Public origin of the share pages and API, without a trailing slash. HTTPS is
# required in production; the frontend also embeds this value at build time.
PUBLIC_ORIGIN=https://example.com
# Keep the API on loopback behind the host reverse proxy.
HOST=127.0.0.1
PORT=3000
# Server-side secret keying the per-share fake-id HMAC (docs/PLAN.md §2.6);
# without it fake ids could be recomputed offline from a leaked share id.
# Generate once (e.g. `openssl rand -hex 32`) and keep it stable — changing
# it changes every share's fake ids.
SANITIZE_SECRET=
# Bot username (without @), used to build t.me deep links and direct links
BOT_USERNAME=
# Mini App short name configured in BotFather
# (t.me/<bot>/<short-name>?startapp=<shareId>)
MINIAPP_SHORT_NAME=

# --- Storage ---
DATA_DIR=./data
# Loopback media origin used by the HTTP server to ask the MTProto bot for a
# registered file. The combined process supervisor generates an ephemeral
# secret when unset; separate processes must use the same explicit value.
INTERNAL_MEDIA_PORT=3001
INTERNAL_MEDIA_SECRET=
# On-demand cache: 24-hour idle TTL, 5 GiB hard ceiling, evicting to 4 GiB.
MEDIA_CACHE_MAX_BYTES=5368709120
MEDIA_CACHE_LOW_WATERMARK_BYTES=4294967296
MEDIA_CACHE_TTL_SECONDS=86400
MEDIA_CACHE_SWEEP_INTERVAL_SECONDS=300
MEDIA_FETCH_CONCURRENCY=2
MEDIA_DOWNLOAD_TIMEOUT_MS=120000
# Public media request governance, applied independently per share and client IP.
MEDIA_REQUESTS_PER_MINUTE=120
MEDIA_REQUEST_BURST=20
MEDIA_BANDWIDTH_BYTES_PER_SECOND=8388608
MEDIA_BANDWIDTH_BURST_BYTES=16777216
# Trust X-Forwarded-For only when every connection reaches this server through
# a reverse proxy that overwrites the header. The source deployment keeps the
# app port private behind Nginx before enabling this.
TRUST_PROXY=0
# Silence window for forward batching (milliseconds)
BATCH_SILENCE_MS=10000

# --- Development ---
# Set to 1 to use the Telegram test DCs instead of production. The test
# environment is fully separate: create a bot with the test-env BotFather,
# and use a different SESSION and DATA_DIR than production. Handy for Mini
# App development — test DCs allow plain-HTTP web origins.
TELEGRAM_TEST_SERVER=
